# AI provider
# Groq is the default. Set the matching key for the selected provider.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o

# Local browser (recommended for the assignment demo)
BROWSER_PROVIDER=local
HEADLESS=False
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
COPART_PERSISTENT_SESSION=True
COPART_PROFILE_DIR=.copart-profile

# Chat and cache behavior
CHAT_RESULTS_PER_PAGE=4
SEARCH_CACHE_TTL_SECONDS=600

# Local API
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Experimental remote-browser deployment
# Shared cloud egress may be rejected by Copart's security service.
# These values are only required when BROWSER_PROVIDER=browserless.
BROWSERLESS_TOKEN=
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io
BROWSERLESS_PROFILE=
BROWSERLESS_SESSION_TIMEOUT_MS=120000
BROWSERLESS_LIVE_TIMEOUT_MS=90000
