LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# The submission/demo defaults to local Chrome.
BROWSER_PROVIDER=local

# Keep local Chrome headed for the demo so human verification can be completed.
# Browserless ignores this setting and displays verification in the frontend.
HEADLESS=False
COPART_PERSISTENT_SESSION=True
COPART_PROFILE_DIR=.copart-profile
# Override only when Chrome is installed somewhere else.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional remote-browser deployment experiment. Shared cloud egress can be
# rejected by Copart's security service; local Chrome remains the reliable demo.
# The token is required only when BROWSER_PROVIDER=browserless.
BROWSERLESS_TOKEN=
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io
BROWSERLESS_PROFILE=
BROWSERLESS_SESSION_TIMEOUT_MS=120000
BROWSERLESS_LIVE_TIMEOUT_MS=90000

# Vehicle snapshots expire after this many seconds.
SEARCH_CACHE_TTL_SECONDS=600
SEARCH_CACHE_MAX_ENTRIES=200

# Maximum records retained while extending a search into later Copart pages.
COPART_MAX_CACHED_RESULTS=500
COPART_MAX_SEARCH_PAGES=10

# When saved matches run out, scan a larger source-page window in the same
# browser visit so a "show more" request is more likely to return a full page.
COPART_CONTINUATION_PAGE_BATCH=15
COPART_MAX_TOTAL_SEARCH_PAGES=60

# Maximum vehicles sent to the chat model in one response. The backend still
# caches the larger source snapshot for "show more" follow-ups.
CHAT_RESULTS_PER_PAGE=4

# Rotate debug.log after it reaches roughly 2 MB.
DEBUG_LOG_MAX_BYTES=2000000

# Local frontend/API settings used by the demo streaming server.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
